{
  "name": "cyberia-audio",
  "version": "0.1.0",
  "description": "Terminal-native audio toolkit for game developers who are not musicians. Semantic game music and SFX.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "cyberia-audio": "./bin/index.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "start": "node bin/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "game-audio",
    "procedural-audio",
    "sfx",
    "game-music",
    "web-audio",
    "cli"
  ],
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@audio/speaker": "^2.3.3",
    "commander": "^15.1.0",
    "dotenv": "^17.4.2",
    "tonal": "^6.4.3"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
